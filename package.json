{
  "name": "agency-erp",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "npm run verify:source && npm run typecheck && npm run lint && npm run build",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "security:audit": "npm audit --audit-level=high",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "verify:enterprise": "npm run verify:release",
    "verify:fresh-db": "bash ./scripts/fresh-db-replay.sh",
    "verify:security": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/security_rls.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/security_rbac_matrix.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/security_storage_and_audit.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/finance_invariants.sql && psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/final_enterprise_hardening.sql",
    "load:test:reservations": "node scripts/load-test-reservations.mjs",
    "verify:storage": "node scripts/verify-storage.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:static": "npm run verify:source && npm run verify:migrations && node scripts/verify-architecture.mjs && node scripts/verify-toolchain-config.mjs && npm run verify:branding && npm run verify:ui-safety && npm run test:finance-utils && npm run verify:maintainability && node scripts/verify-nusuk-isolation.mjs",
    "verify:e2e": "node scripts/e2e-full.mjs",
    "verify:accounting": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/accounting_workflows.sql",
    "verify:reservation-concurrency": "node scripts/verify-reservation-concurrency.mjs",
    "verify:release:static": "npm run verify:static",
    "verify:behavioral-rbac": "node scripts/behavioral-rbac.mjs",
    "verify:no-demo": "node scripts/verify-no-demo-data.mjs",
    "verify:branding": "node scripts/verify-branding.mjs",
    "prebuild": "npm run verify:source-syntax && node scripts/generate-sitemap.mjs",
    "verify:ui-safety": "node scripts/verify-ui-safety.mjs",
    "test:finance-utils": "node scripts/test-finance-utilities.mjs",
    "verify:e2e:roles": "node scripts/e2e-roles.mjs",
    "verify:security:storage:runtime": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/security_storage_runtime.sql",
    "verify:reservation:concurrency": "node scripts/verify-reservation-concurrency.mjs",
    "verify:e2e:accessibility": "node scripts/e2e-accessibility.mjs",
    "verify:backup-restore": "bash scripts/backup-restore-drill.sh",
    "verify:source-syntax": "node scripts/verify-source-syntax.mjs",
    "verify:release-hardening": "node scripts/verify-no-dead-artifacts.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "verify:all": "npm run verify:release-hardening && npm run verify:static && npm run typecheck && npm run lint && npm run build",
    "verify:clean-release": "node scripts/verify-no-dead-artifacts.mjs",
    "verify:maintainability": "node scripts/verify-maintainability.mjs",
    "test:maintainability": "node scripts/verify-maintainability.mjs && node scripts/verify-source.mjs && node scripts/verify-migrations.mjs && node scripts/verify-architecture.mjs && node scripts/verify-toolchain-config.mjs && node scripts/verify-ui-safety.mjs"
  },
  "dependencies": {
    "@number-flow/react": "0.5.14",
    "@supabase/supabase-js": "^2.57.4",
    "@visx/curve": "4.0.1-alpha.0",
    "@visx/event": "4.0.1-alpha.0",
    "@visx/grid": "4.0.1-alpha.0",
    "@visx/group": "4.0.1-alpha.0",
    "@visx/responsive": "4.0.1-alpha.0",
    "@visx/scale": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "animejs": "4.5.0",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "d3-shape": "3.2.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.446.0",
    "motion": "12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.7.1",
    "react-hot-toast": "2.6.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/container-queries": "0.1.1",
    "@types/animejs": "3.1.13",
    "@types/d3-array": "3.2.2",
    "@types/d3-shape": "3.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10 <11"
  },
  "author": ""
}
